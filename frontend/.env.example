# TenderIQ Frontend Environment Variables
# Copy this file to .env and fill in your values
# Note: Only variables prefixed with VITE_ are exposed to the client

# API Configuration
VITE_API_URL=http://localhost:8000/api/v1

# App Configuration
VITE_APP_NAME=TenderIQ
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_AI_CHAT=true
VITE_ENABLE_EXPORTS=true
VITE_ENABLE_AUDIT_LOGS=true

# Theme
VITE_DEFAULT_THEME=system  # light, dark, system

# Pagination
VITE_DEFAULT_PAGE_SIZE=25

# File Upload
VITE_MAX_FILE_SIZE=52428800  # 50MB

# Session
VITE_SESSION_TIMEOUT=1800000  # 30 minutes in milliseconds

# External Services (if needed client-side)
# VITE_SENTRY_DSN=
# VITE_GA_TRACKING_ID=