# TenderIQ Backend Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME=TenderIQ
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
API_PREFIX=/api/v1

# Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tenderiq
DATABASE_ECHO=false

# Security & JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
SECRET_KEY=your-super-secret-key-change-in-production

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Multi-tenancy
TENANT_HEADER=x-organization-id
USER_HEADER=x-user-id

# File Storage
STORAGE_ROOT=./data
STORAGE_LOCAL_PATH=./storage
UPLOAD_DIR=./data/uploads
VECTOR_STORE_DIR=./data/vectorstore
MAX_FILE_SIZE=52428800  # 50MB
ALLOWED_FILE_TYPES=application/pdf
ALLOWED_EXTENSIONS=.pdf

# AI & LLM Configuration
# Provider: gemini, ollama
LLM_PROVIDER=gemini

# Google Gemini (Primary)
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_CHAT_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=models/embedding-001

# Ollama (Local / Fallback)
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ChromaDB Vector Database
# Mode: "local" for file-based (dev), "http" for HTTP client (production/Docker)
CHROMA_MODE=http
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=tenderiq_documents
CHROMADB_PATH=./chroma_db
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Vector Database (pgvector)
VECTOR_DB_URL=postgresql://postgres:postgres@localhost:5432/tender_rfp

# Redis (for caching, rate limiting, Celery)
REDIS_URL=redis://localhost:6379/0

# Email (for notifications, invitations)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@tenderiq.com
SMTP_USE_TLS=true

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # seconds