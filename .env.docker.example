# ==============================================================================
# TenderIQ - Production Container Environment Variables
# ==============================================================================

# Application
APP_NAME=TenderIQ
ENVIRONMENT=production
DEBUG=false
API_PREFIX=/api/v1

# Security & Authentication (Change this to a strong 32+ character random secret)
SECRET_KEY=replace-with-a-very-strong-production-secret-key-32-chars
JWT_SECRET=replace-with-a-very-strong-production-secret-key-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://tenderiq:tenderiq_secure_password@postgres:5432/tenderiq

# Redis Cache & Background Tasks
REDIS_URL=redis://redis:6379/0

# Chroma Vector Database
CHROMA_MODE=http
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=tenderiq_documents

# AI & LLM Provider Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Ollama (if using local AI model instead of Gemini)
USE_OLLAMA=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Container Startup Controls
RUN_MIGRATIONS=true
ENABLE_WORKER=false
